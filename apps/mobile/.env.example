# Public build-time values only (they ship inside the app). Copy to .env.local for development.
APP_VARIANT=development
# Android emulator reaches the host as 10.0.2.2; a physical phone needs your PC's LAN IP or a tunnel.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Shows "Sign in with a dev account" — development builds only.
EXPO_PUBLIC_DEV_LOGIN=true
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_PRIVACY_URL=https://reeldrama.example/privacy
EXPO_PUBLIC_TERMS_URL=https://reeldrama.example/terms
# Real AdMob app ids for production builds (defaults are Google's TEST ids)
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
