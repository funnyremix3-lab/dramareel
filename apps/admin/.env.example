# Copy to .env.local and fill in. Every NEXT_PUBLIC_* value is shipped to the browser,
# so only public values belong here: never a service-role key or any other secret.
# NEXT_PUBLIC_* values are inlined at build time (pass them as Docker build args).

# Reel Drama API base URL, including /api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Supabase project (public anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Show the development sign-in buttons (POST /dev/token). Never enable in production;
# the API only exposes /dev/token outside production anyway.
NEXT_PUBLIC_DEV_LOGIN=false
