# Copy to .env for local development. Placeholders only — never commit real values.

NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001

# PostgreSQL (local: docker compose; prod: managed Postgres / Supabase)
DATABASE_URL=postgresql://reeldrama:reeldrama@localhost:5432/reeldrama
DIRECT_DATABASE_URL=postgresql://reeldrama:reeldrama@localhost:5432/reeldrama

REDIS_URL=redis://localhost:6379

# Supabase Auth — JWT verification
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Only for legacy Supabase projects that still sign with the HS256 JWT secret.
SUPABASE_JWT_SECRET=
# Local/test only (>= 32 chars): lets `npm run dev:token -- viewer` mint tokens for seeded dev accounts.
# MUST be empty in production — the API refuses to start otherwise.
DEV_JWT_SECRET=

# Object storage (local: MinIO; prod: Cloudflare R2, private buckets)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=reel-drama-dev
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Public images: object keys start with public/ (posters, thumbnails). Video is never served from here.
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/dev-media

# Playback tokens (shared with the Cloudflare media worker)
MEDIA_BASE_URL=http://localhost:3000/dev-media
# Local development only: serve /dev-media from the API (must be false in production)
DEV_MEDIA_PROXY=false
PLAYBACK_SIGNING_KEY=replace-with-32-random-bytes-base64
PLAYBACK_TOKEN_TTL_SECONDS=21600

# Ads — rewards are granted ONLY via AdMob server-side verification when enabled (required in production).
# Set the SSV callback URL on each rewarded ad unit in AdMob: https://api.<domain>/api/v1/ads/admob/ssv
ADMOB_SSV_ENABLED=false
ADMOB_SSV_MAX_AGE_SECONDS=21600
REWARD_CLAIM_TTL_SECONDS=1800
# Signs direct-campaign serve tokens (32 random bytes, base64). Required in production.
ADS_SERVE_SIGNING_KEY=

# Payments — keep false until verification & compliance tests pass
PAYMENTS_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.reeldrama.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=
# Pub/Sub push subscription (OIDC) for Real-time Developer Notifications
GOOGLE_RTDN_AUDIENCE=
GOOGLE_RTDN_SERVICE_ACCOUNT_EMAIL=

# Observability
LOG_LEVEL=info
SENTRY_DSN=
SWAGGER_ENABLED=true
