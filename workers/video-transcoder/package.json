{
  "name": "@reel-drama/video-transcoder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/sync-schema.js && prisma generate --schema prisma/schema.prisma",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "seed:media": "tsx scripts/seed-sample-media.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@prisma/client": "6.16.2",
    "bullmq": "^5.81.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.5.2",
    "prisma": "6.16.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
